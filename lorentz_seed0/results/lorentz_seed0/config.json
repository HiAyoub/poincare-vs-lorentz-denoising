{
  "name": "lorentz",
  "output_dir": "/kaggle/working/results",
  "data": {
    "root": null,
    "image_size": 384,
    "patch_size": 256,
    "val_seed": 1,
    "num_workers": 2
  },
  "model": {
    "encoder": "lorentz",
    "base_channels": 32,
    "depth": 4,
    "curvature_init": 0.5,
    "trainable_curvature": true
  },
  "train": {
    "epochs": 30,
    "batch_size": 4,
    "lr": 0.0002,
    "weight_decay": 0.0001,
    "curvature_weight_decay": 0.0,
    "warmup_epochs": 1,
    "grad_clip": 1.0
  },
  "eval": {
    "crop": "none",
    "noise_seed": 7,
    "batch_size": 2
  },
  "seed": 0
}